{
  "schemaVersion": 1,
  "id": "derekross.calendar",
  "name": "Calendar Clock",
  "version": "0.2.0",
  "author": "Derek Ross",
  "license": "MIT",
  "description": "Omarchy's clock and calendar with your events in it: dots on the month grid, an agenda with meeting links and directions, and notifications before each event. Replaces the built-in clock. Works with any calendar khal reads: Google, CalDAV, Nextcloud, Fastmail, iCloud, local .ics.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "omarchy": {
    "clonedFrom": "omarchy.clock"
  },
  "barWidget": {
    "displayName": "Calendar Clock",
    "description": "Clock with a calendar popup that shows your khal events",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "leadMinutes": 10,
      "notifications": true,
      "agendaDays": 7,
      "syncIntervalMinutes": 15,
      "syncCommand": "vdirsyncer sync",
      "timeFormat": "Match khal",
      "mapsProvider": "Google Maps"
    },
    "schema": [
      {
        "key": "format",
        "type": "string",
        "label": "Label format",
        "description": "Qt date format, e.g. dddd HH:mm. Right-click the clock to cycle presets.",
        "defaultValue": "dddd HH:mm"
      },
      {
        "key": "formatAlt",
        "type": "string",
        "label": "Alternate format",
        "description": "Added to the right-click cycle.",
        "defaultValue": "d MMMM 'W'ww yyyy"
      },
      {
        "key": "notifications",
        "type": "boolean",
        "label": "Notifications",
        "description": "Notify before each timed event.",
        "defaultValue": true
      },
      {
        "key": "leadMinutes",
        "type": "integer",
        "label": "Notify minutes before",
        "min": 0,
        "max": 240,
        "step": 5,
        "defaultValue": 10
      },
      {
        "key": "agendaDays",
        "type": "integer",
        "label": "Agenda days",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 7
      },
      {
        "key": "timeFormat",
        "type": "enum",
        "label": "Time format",
        "options": [
          "Match khal",
          "12-hour",
          "24-hour"
        ],
        "defaultValue": "Match khal"
      },
      {
        "key": "mapsProvider",
        "type": "enum",
        "label": "Directions",
        "description": "Map site used for event locations.",
        "options": [
          "Google Maps",
          "OpenStreetMap",
          "Apple Maps"
        ],
        "defaultValue": "Google Maps"
      },
      {
        "key": "syncIntervalMinutes",
        "type": "integer",
        "label": "Sync every (minutes)",
        "description": "0 turns syncing off, e.g. when a systemd timer already runs it.",
        "min": 0,
        "max": 1440,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "syncCommand",
        "type": "string",
        "label": "Sync command",
        "description": "Run with sh -c. Leave empty to never sync.",
        "defaultValue": "vdirsyncer sync"
      }
    ]
  }
}
